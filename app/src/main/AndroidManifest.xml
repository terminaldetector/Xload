<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately no INTERNET permission: models and datasets are imported from
        local storage via the Storage Access Framework, and training runs entirely
        on-device (see the project plan's "без выгрузки данных в облако" goal).
    -->

    <application
        android:name=".XloadApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xload">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Xload">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
